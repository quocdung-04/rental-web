Table tenants {
  tenant_id bigint [pk, increment]
  full_name nvarchar(100) [not null]
  email varchar(100) [not null, unique]
  phone varchar(15) [not null]
}

Table properties {
  property_id bigint [pk, increment]
  address nvarchar(255) [not null, unique]
  monthly_rent decimal(14,2) [not null]
  availability_status varchar(20) [not null, default: 'AVAILABLE', note: 'AVAILABLE | RENTED']
  title nvarchar(120) [not null]
  district nvarchar(60) [not null]
  bedrooms int [not null]
  bathrooms int [not null]
  area_sqm int [not null]
  image_url varchar(255)
  description nvarchar(1000)
}

Table maintenance_requests {
  request_id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.tenant_id]
  property_id bigint [not null, ref: > properties.property_id]
  description nvarchar(2000) [not null]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING | IN_PROGRESS | DONE']
  category varchar(30) [not null, default: 'OTHER']
  priority varchar(10) [not null, default: 'NORMAL', note: 'LOW | NORMAL | HIGH']
  reference_code varchar(20)
  created_at datetime2 [not null]
}
